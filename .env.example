# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - PROJETO TATU
# ==============================================================================
# ATENÇÃO: NUNCA insira chaves, senhas ou tokens reais neste arquivo ou no repositório.
# Este arquivo é um modelo (template) para documentar as variáveis suportadas.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS DO FRONTEND (PREFIXO VITE_ OBRIGATÓRIO)
# ------------------------------------------------------------------------------
# ATENÇÃO: Qualquer variável com o prefixo VITE_ é embutida no bundle JavaScript
# compilado e é TOTALMENTE VISÍVEL no navegador de qualquer usuário.
# NUNCA coloque chaves secretas, credenciais de banco de dados ou senhas com este prefixo.

# URL base da API backend (vazio utiliza a mesma origem da aplicação via rotas relativas /api)
VITE_API_URL=""

# Ambiente de execução da aplicação frontend ('development', 'staging', 'production')
VITE_APP_ENV="development"


# ------------------------------------------------------------------------------
# 2. SEGREDOS EXCLUSIVAMENTE SERVER-SIDE (SEM PREFIXO VITE_)
# ------------------------------------------------------------------------------
# ATENÇÃO: As variáveis abaixo são estritamente para o ambiente de servidor (Node.js,
# Cloud Run, Vercel Serverless Functions). Elas JAMAIS devem ser expostas ou
# referenciadas no código do cliente React/Vite.

# GEMINI_API_KEY: Chave da API do Google Gemini.
# AI Studio injeta esta chave automaticamente em tempo de execução a partir de secrets do usuário.
# Obrigatória apenas para rotas server-side de IA. NUNCA utilize no frontend.
GEMINI_API_KEY=""

# APP_URL: URL canônica do serviço hospedado.
# Injetada automaticamente pelo ambiente de nuvem (ex: Cloud Run).
APP_URL=""

# ------------------------------------------------------------------------------
# 3. VARIÁVEIS PARA INTEGRAÇÕES FUTURAS (PLANEJAMENTO ARQUITETURAL)
# ------------------------------------------------------------------------------
# As variáveis abaixo serão necessárias quando a autenticação e o banco Neon
# forem implementados na camada de servidor:

# DATABASE_URL: String de conexão com o banco Neon PostgreSQL.
# DEVE RESIDIR EXCLUSIVAMENTE NO SERVIDOR. O frontend NUNCA conecta direto ao banco.
# Exemplo de formato: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# JWT_SECRET: Segredo criptográfico para assinatura e verificação de tokens de autenticação.
# DEVE RESIDIR EXCLUSIVAMENTE NO SERVIDOR.
JWT_SECRET=""
